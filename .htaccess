# Temporarily exclude BookOrGo from search engines.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Keep repository metadata and environment files private.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.git(/|$) - [F,L]
  RewriteRule (^|/)\.env([^/]*)(/|$) - [F,L]
</IfModule>
